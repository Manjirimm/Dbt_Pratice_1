)

SELECT * FROM manhattan_violation_codes
UNION ALL
SELECT * FROM all_other_violation_codes
ORDER BY violation_code ASC
) SELECT
    violation_code,
    SUM(fee_usd) AS total_revenue_usd
FROM
    __dbt__cte__silver_parking_violation_codes
GROUP BY
    violation_code
HAVING
    NOT(total_revenue_usd >= 1)
    );
  
  
    
